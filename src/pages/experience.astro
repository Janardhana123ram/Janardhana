---
import BaseHead from '../components/BaseHead.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Experience | {SITE_TITLE}" description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section>
				<h1>Experience</h1>

				<p>
					My professional journey spans multiple companies and roles, working on
					Developer Experience, Build Systems, CI/CD, and platform engineering.
				</p>

				<Experience />
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
	}

	h1 {
		font-size: 2.369rem;
		margin-bottom: 1rem;
	}

	p {
		line-height: 1.6;
		color: rgb(var(--gray));
		margin-bottom: 2rem;
	}

	@media (max-width: 720px) {
		main {
			width: 100%;
		}

		h1 {
			font-size: 1.563rem;
		}
	}
</style>
